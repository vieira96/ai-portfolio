PORT=8000
NODE_ENV=development
APP_URL=http://localhost:8000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=portfolio
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio?schema=public"
# Fila/Redis (lida e obrigatória — o backend não sobe sem ela)
REDIS_URL="redis://localhost:6379"
# CORS (obrigatória — uma ou mais origens separadas por vírgula; o backend não sobe sem ao menos uma válida)
CORS_ORIGINS="http://localhost:3000"
LOCAL_UID=1000
LOCAL_GID=1000

# IA / Ollama (obrigatórias — o backend não sobe sem elas)
OLLAMA_URL="http://localhost:11434"
OLLAMA_CHAT_MODEL="qwen2.5:7b"
OLLAMA_TIMEOUT_MS=60000

# IA / Groq (opcional — sem a key, segue só o Ollama local)
# Chave criada em https://console.groq.com/keys (nunca commite a chave real)
# GROQ_API_KEY="cole-aqui-a-chave-criada-no-console"
GROQ_MODEL="openai/gpt-oss-120b"
GROQ_TIMEOUT_MS=60000

# IA / Gemini (opcional — sem a key, segue para o Ollama)
# Chave criada em https://aistudio.google.com/apikey (nunca commite a chave real)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.1-flash-lite"
GEMINI_TIMEOUT_MS=60000

# Auth (obrigatório — mínimo 32 caracteres)
JWT_SECRET="troque-por-um-segredo-de-32-caracteres-no-minimo"

# Seed do usuário único (obrigatórias: NAME, EMAIL, PASSWORD)
SEED_USER_NAME="Seu Nome"
SEED_USER_EMAIL="voce@example.com"
SEED_USER_PASSWORD="troque-esta-senha-com-8-caracteres-no-minimo"

# Seed do usuário único (opcionais — se ausentes, ficam null e completam via PATCH /users/me)
# SEED_USER_HEADLINE="Backend / Full Stack Developer"
# SEED_USER_BIO="..."
# SEED_USER_LOCATION="..."
# SEED_USER_GITHUB_URL="https://github.com/..."
# SEED_USER_LINKEDIN_URL="https://linkedin.com/in/..."
# SEED_USER_PORTFOLIO_URL="https://..."
